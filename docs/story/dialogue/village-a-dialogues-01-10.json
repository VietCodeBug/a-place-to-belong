  "status": "draft_pending_approval",
  "group": "01-10",
  "people": [
    {
      "id": "VLA-01",
      "name_en_draft": "Hazel",
      "roster_priority": "core",
      "traits_vi": "thẳng thắn, kiên nhẫn",
      "activity": {
        "id": "VLA01-ACT",
        "description_vi": "Tưới một phần luống cây non",
        "visible_change_vi": "Luống đã tưới; Hazel nhớ A giúp",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA01-Q01",
          "speaker_id": "A",
          "text_vi": "Mấy luống này vừa lên mầm à?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA01-A01",
          "speaker_id": "VLA-01",
          "text_vi": "Ừ. Mầm còn yếu, nước vừa phải thôi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA01-D01",
          "speaker_id": "VLA-01",
          "text_vi": "Không sao, tôi làm nốt được.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA01-R01",
          "speaker_id": "VLA-01",
          "text_vi": "Lá hôm nay có vẻ khỏe hơn hôm qua.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA01-F01",
          "speaker_id": "VLA-01",
          "text_vi": "Lúc trước tôi quen tự làm hết. Có thêm người nhớ tới luống cây cũng tốt.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA01-B01",
          "speaker_id": "VLA-01",
          "text_vi": "Đợi tôi xem xong luống này đã, nói chuyện sau nhé.",
          "status": "draft_pending_approval"
        }
      ],
