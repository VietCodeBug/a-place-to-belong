    {
      "id": "VLA-04",
      "name_en_draft": "Owen",
      "roster_priority": "core",
      "traits_vi": "ít lời, cẩn thận",
      "activity": {
        "id": "VLA04-ACT",
        "description_vi": "Giữ chốt gỗ cho Owen sửa",
        "visible_change_vi": "Chốt chắc hơn; Owen nhớ A hỗ trợ",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA04-Q01",
          "speaker_id": "A",
          "text_vi": "Ông đang sửa cái gì vậy?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA04-A01",
          "speaker_id": "VLA-04",
          "text_vi": "Cái chốt này lỏng. Giữ đúng chỗ thì sửa cũng nhanh.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA04-D01",
          "speaker_id": "VLA-04",
          "text_vi": "Không sao. Tôi kiếm chỗ kê tạm vậy.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA04-R01",
          "speaker_id": "VLA-04",
          "text_vi": "Cái chốt hôm trước vẫn chưa chịu nằm yên.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA04-F01",
          "speaker_id": "VLA-04",
          "text_vi": "Tôi cứ nhận sửa đồ cho mọi nhà. Còn việc ở chỗ mình thì hay để cuối.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA04-B01",
          "speaker_id": "VLA-04",
          "text_vi": "Đừng chạm vào ván này lúc tôi đang chỉnh.",
          "status": "draft_pending_approval"
        }
      ],
