    {
      "id": "VLA-02",
      "name_en_draft": "Nora",
      "roster_priority": "ambient",
      "traits_vi": "nhẹ nhàng, tinh ý",
      "activity": {
        "id": "VLA02-ACT",
        "description_vi": "Nhận biết mùi chậu thảo mộc",
        "visible_change_vi": "A ghi nhớ loại thảo mộc đã quan sát",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA02-I01",
          "speaker_id": "VLA-02",
          "text_vi": "Chào cậu. Đứng xa một chút cũng ngửi thấy mùi lá này rồi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-Q01",
          "speaker_id": "A",
          "text_vi": "Đó là loại lá gì vậy?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-A01",
          "speaker_id": "VLA-02",
          "text_vi": "Tôi thường vò nhẹ một chiếc lá để nhận mùi. Không cần ngắt cả nhánh đâu.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-O01",
          "speaker_id": "A",
          "text_vi": "Tôi thử nhận mùi một chậu được không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-Y01",
          "speaker_id": "VLA-02",
          "text_vi": "Được. Thử chậu gần bậc cửa trước xem.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-C01",
          "speaker_id": "VLA-02",
          "text_vi": "Đúng rồi, không cần vội mà vẫn nhận ra được.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-D01",
          "speaker_id": "VLA-02",
          "text_vi": "Cứ để khi nào cậu tò mò hơn cũng được.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-R01",
          "speaker_id": "VLA-02",
          "text_vi": "Hôm nay lá thơm hơn một chút. Có lẽ tại gió.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-F01",
          "speaker_id": "VLA-02",
          "text_vi": "Tôi hay nhớ người khác thích mùi gì hơn là nhớ họ đã nói bao nhiêu câu.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA02-B01",
          "speaker_id": "VLA-02",
          "text_vi": "Để tôi đặt chậu này xuống đã, tay đang dính đất.",
          "status": "draft_pending_approval"
        }
      ],
