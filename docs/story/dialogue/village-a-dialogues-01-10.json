    {
      "id": "VLA-06",
      "name_en_draft": "Clara",
      "roster_priority": "core",
      "traits_vi": "ấm áp, cầu toàn",
      "activity": {
        "id": "VLA06-ACT",
        "description_vi": "Bày bát, khăn, đồ ăn cho một bữa nhỏ",
        "visible_change_vi": "Bàn ăn sẵn sàng; bữa ăn vẫn diễn ra nếu A không giúp",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA06-I01",
          "speaker_id": "VLA-06",
          "text_vi": "Chào cậu. Vào đúng lúc tôi đang chuẩn bị bữa ăn rồi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-Q01",
          "speaker_id": "A",
          "text_vi": "Mọi người thường ăn cùng nhau à?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-A01",
          "speaker_id": "VLA-06",
          "text_vi": "Khi sắp xếp được thì có. Một bữa đơn giản cũng đủ vui rồi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-O01",
          "speaker_id": "A",
          "text_vi": "Tôi bày bàn giúp được không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-Y01",
          "speaker_id": "VLA-06",
          "text_vi": "Được chứ. Đặt mấy chiếc bát trước, để chỗ trống cho món nóng nhé.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-C01",
          "speaker_id": "VLA-06",
          "text_vi": "Đẹp rồi. À, hơi lệch một chút... thôi, để vậy cũng dễ thương.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-D01",
          "speaker_id": "VLA-06",
          "text_vi": "Không sao, cậu cứ đi quanh xem. Tôi làm được.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-R01",
          "speaker_id": "VLA-06",
          "text_vi": "Tôi lại đang phân vân có nên bày thêm một món không.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-F01",
          "speaker_id": "VLA-06",
          "text_vi": "Tôi cứ nghĩ cái gì chưa vừa ý thì phải sửa ngay. Gần đây tôi đang tập ngồi xuống ăn trước đã.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA06-B01",
          "speaker_id": "VLA-06",
          "text_vi": "Để tôi lấy cái khay nóng xuống rồi nói tiếp nhé.",
          "status": "draft_pending_approval"
        }
      ],
      "groups": {
