    {
      "id": "VLA-07",
      "name_en_draft": "Felix",
      "roster_priority": "supporting",
      "traits_vi": "hóm hỉnh, chu đáo",
      "activity": {
        "id": "VLA07-ACT",
        "description_vi": "Kiểm tra tình trạng luống ngũ cốc",
        "visible_change_vi": "A nhận ra tình trạng đất; không tự tăng sản lượng",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA07-I01",
          "speaker_id": "VLA-07",
          "text_vi": "Đừng giẫm vào đây nhé. Luống này chưa sẵn sàng chịu khách đâu!",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-Q01",
          "speaker_id": "A",
          "text_vi": "Trồng ngũ cốc có khó không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-A01",
          "speaker_id": "VLA-07",
          "text_vi": "Khó nhất là biết lúc nào nên để đất nghỉ. Tôi lúc nào cũng muốn gieo thêm.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-O01",
          "speaker_id": "A",
          "text_vi": "Tôi đi kiểm mấy luống với anh nhé?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-Y01",
          "speaker_id": "VLA-07",
          "text_vi": "Được. Cứ nhìn màu đất trước, đừng vội nhổ cây lên.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-C01",
          "speaker_id": "VLA-07",
          "text_vi": "Tốt. Hóa ra đứng nhìn cũng là một phần công việc.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-D01",
          "speaker_id": "VLA-07",
          "text_vi": "Thế cũng được. Đất đâu có chạy mất.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-R01",
          "speaker_id": "VLA-07",
          "text_vi": "Tôi đang thử không làm gì với một luống. Khổ ghê.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-F01",
          "speaker_id": "VLA-07",
          "text_vi": "Có khi bớt một vụ trồng lại là cách chăm khu vườn tốt nhất.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA07-B01",
          "speaker_id": "VLA-07",
          "text_vi": "Chờ tôi ghi nốt dấu này rồi hãy hỏi.",
          "status": "draft_pending_approval"
        }
      ],
      "groups": {
