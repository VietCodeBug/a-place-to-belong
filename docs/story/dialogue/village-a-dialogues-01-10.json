    {
      "id": "VLA-05",
      "name_en_draft": "June",
      "roster_priority": "supporting",
      "traits_vi": "nhanh nhẹn, thực tế",
      "activity": {
        "id": "VLA05-ACT",
        "description_vi": "Sắp dụng cụ về đúng ngăn",
        "visible_change_vi": "Kệ gọn; June nhớ người đã hỏi trước khi đụng đồ",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA05-I01",
          "speaker_id": "VLA-05",
          "text_vi": "Tìm ai à? Nếu cần mượn dụng cụ, cứ hỏi trước nhé.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-Q01",
          "speaker_id": "A",
          "text_vi": "Chị nhớ hết đống đồ này nằm đâu sao?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-A01",
          "speaker_id": "VLA-05",
          "text_vi": "Không nhớ hết thì phải có chỗ cố định. Kẻo sáng nào cũng đi tìm búa.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-O01",
          "speaker_id": "A",
          "text_vi": "Tôi sắp giúp mấy món đã dùng xong nhé?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-Y01",
          "speaker_id": "VLA-05",
          "text_vi": "Được, đặt đúng ngăn có nhãn. Món nào không chắc thì cứ hỏi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-C01",
          "speaker_id": "VLA-05",
          "text_vi": "Gọn rồi. Cảm ơn cậu đã không tự tiện đổi chỗ.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-D01",
          "speaker_id": "VLA-05",
          "text_vi": "Ừ, không vội. Tôi sắp sau cũng được.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-R01",
          "speaker_id": "VLA-05",
          "text_vi": "Có người lại để kéo sang ngăn đinh rồi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-F01",
          "speaker_id": "VLA-05",
          "text_vi": "Tôi chỉ muốn mọi người đỡ tốn thời gian tìm đồ. Có thế thôi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA05-B01",
          "speaker_id": "VLA-05",
          "text_vi": "Khoan, tôi đang kiểm xem thiếu món nào.",
          "status": "draft_pending_approval"
        }
      ],
