    {
      "id": "VLA-10",
      "name_en_draft": "Silas",
      "roster_priority": "supporting",
      "traits_vi": "cởi mở, có phần hấp tấp",
      "activity": {
        "id": "VLA10-ACT",
        "description_vi": "Thử đan một đoạn giỏ đơn giản",
        "visible_change_vi": "Đoạn đan mẫu hoàn thành, không tự sinh vật phẩm",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA10-I01",
          "speaker_id": "VLA-10",
          "text_vi": "Chào! Đến đúng lúc tôi vừa làm rối cả nắm sợi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-Q01",
          "speaker_id": "A",
          "text_vi": "Đan giỏ có dễ không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-A01",
          "speaker_id": "VLA-10",
          "text_vi": "Dễ nếu cậu không vừa làm vừa nghĩ sang chuyện khác. Tôi thì hay thế.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-O01",
          "speaker_id": "A",
          "text_vi": "Tôi thử đan một đoạn nhé?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-Y01",
          "speaker_id": "VLA-10",
          "text_vi": "Thử đi! Khoan... để tôi gỡ chỗ rối này trước.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-C01",
          "speaker_id": "VLA-10",
          "text_vi": "Đấy, được rồi! Cậu làm chậm mà chắc hơn tôi đấy.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA10-D01",
