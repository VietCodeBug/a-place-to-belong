    {
      "id": "VLA-03",
      "name_en_draft": "Finn",
      "roster_priority": "ambient",
      "traits_vi": "tò mò, hay quên",
      "activity": {
        "id": "VLA03-ACT",
        "description_vi": "Đứng quan sát côn trùng cùng Finn",
        "visible_change_vi": "Ghi nhận nơi quan sát; không bắt hay hại côn trùng",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA03-I01",
          "speaker_id": "VLA-03",
          "text_vi": "Ê, cậu đứng yên được không? Có con bọ ngay cạnh chân kìa!",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-Q01",
          "speaker_id": "A",
          "text_vi": "Cậu hay tìm bọ thế à?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-A01",
          "speaker_id": "VLA-03",
          "text_vi": "Ừ! Chúng nó đi đâu cũng có việc. Tôi thì đôi lúc quên mất mình đang làm gì.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-O01",
          "speaker_id": "A",
          "text_vi": "Tôi xem cùng một lúc nhé?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-Y01",
          "speaker_id": "VLA-03",
          "text_vi": "Được, nhưng đừng nhấc cái lá đó lên. Nó đang trốn.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-C01",
          "speaker_id": "VLA-03",
          "text_vi": "Thấy chưa! Chỉ cần đợi là nó tự bò ra.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-D01",
          "speaker_id": "VLA-03",
          "text_vi": "Thế thôi. Tôi nhìn tiếp đây.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-R01",
          "speaker_id": "VLA-03",
          "text_vi": "Tôi vẫn chưa tìm được con bọ có chấm trên lưng hôm qua.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-F01",
          "speaker_id": "VLA-03",
          "text_vi": "Tôi đang tập không chạy qua luống rau nữa. Khó hơn tưởng tượng đấy.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA03-B01",
          "speaker_id": "VLA-03",
          "text_vi": "Suỵt! Nó sắp bò qua khe đá!",
          "status": "draft_pending_approval"
        }
      ],
