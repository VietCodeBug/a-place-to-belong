    {
      "id": "VLA-09",
      "name_en_draft": "Rowan",
      "roster_priority": "core",
      "traits_vi": "điềm đạm, nguyên tắc",
      "activity": {
        "id": "VLA09-ACT",
        "description_vi": "Dọn nhánh chắn đường mà không làm hại hoa dại",
        "visible_change_vi": "Lối đi thông hơn; hoa vẫn còn",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA09-I01",
          "speaker_id": "VLA-09",
          "text_vi": "Lối này đi được, nhưng nhớ nhìn xuống chân.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-Q01",
          "speaker_id": "A",
          "text_vi": "Ông chăm cả con đường này sao?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-A01",
          "speaker_id": "VLA-09",
          "text_vi": "Tôi giữ chỗ cần đi cho dễ đi. Chỗ nào cây vẫn sống yên thì cứ để yên.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-O01",
          "speaker_id": "A",
          "text_vi": "Tôi dọn giúp cành khô được không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-Y01",
          "speaker_id": "VLA-09",
          "text_vi": "Được. Chỉ cành chắn lối thôi, đừng nhổ cả bụi hoa cạnh đó.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-C01",
          "speaker_id": "VLA-09",
          "text_vi": "Được rồi. Đường thông mà hoa vẫn còn, vậy là tốt.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-D01",
          "speaker_id": "VLA-09",
          "text_vi": "Không sao. Khi đi qua, cậu chỉ cần đừng giẫm lên hoa.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-R01",
          "speaker_id": "VLA-09",
          "text_vi": "Một đoạn đường hôm nay vừa có thêm lá rụng.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-F01",
          "speaker_id": "VLA-09",
          "text_vi": "Giữ đường đi không có nghĩa là biến cả khu rừng thành sân sạch.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA09-B01",
          "speaker_id": "VLA-09",
          "text_vi": "Đừng đứng trên đoạn đất mềm kia. Tôi đang xem nó có lún không.",
          "status": "draft_pending_approval"
        }
      ],
      "groups": {
        "intro": {
