    {
      "id": "VLA-08",
      "name_en_draft": "Olive",
      "roster_priority": "ambient",
      "traits_vi": "lém lỉnh, thích màu sắc",
      "activity": {
        "id": "VLA08-ACT",
        "description_vi": "Xem tranh và chọn chi tiết yêu thích",
        "visible_change_vi": "Olive nhớ chi tiết A đã chú ý; không cho lấy tranh",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA08-I01",
          "speaker_id": "VLA-08",
          "text_vi": "Này, cậu nhìn bức này xem! Đừng đoán ngay nhé.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-Q01",
          "speaker_id": "A",
          "text_vi": "Cậu vẽ chỗ nào thế?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-A01",
          "speaker_id": "VLA-08",
          "text_vi": "Một góc sân thôi. Nhưng phải nhìn kỹ mới thấy nó đẹp.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-O01",
          "speaker_id": "A",
          "text_vi": "Tôi chỉ chỗ tôi thích nhất được không?",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-Y01",
          "speaker_id": "VLA-08",
          "text_vi": "Được! Nhưng đừng bảo tất cả đều đẹp nhé, thế thì khó chọn lắm.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-C01",
          "speaker_id": "VLA-08",
          "text_vi": "Ồ, cậu cũng nhìn thấy cái bóng bé xíu đó à!",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-D01",
          "speaker_id": "VLA-08",
          "text_vi": "Không sao, tôi vẽ tiếp đây.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-R01",
          "speaker_id": "VLA-08",
          "text_vi": "Hôm nay tôi thử vẽ cái chậu cũ. Nó toàn lệch thôi.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-F01",
          "speaker_id": "VLA-08",
          "text_vi": "Tôi thích vẽ những thứ người lớn hay đi qua mà không nhìn.",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA08-B01",
          "speaker_id": "VLA-08",
          "text_vi": "Đừng rung bàn! Tôi đang vẽ một nét thật nhỏ.",
          "status": "draft_pending_approval"
        }
      ],
      "groups": {
