          "status": "draft_pending_approval"
        },
        {
          "id": "VLA19-A01",
          "speaker_id": "VLA-19",
          "text_vi": "Tôi lo sao cho đến nơi chúng vẫn còn nguyên. Người đi đường lo phần đường.",
