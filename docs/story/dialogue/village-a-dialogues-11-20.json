          "status": "draft_pending_approval"
        },
        {
          "id": "VLA19-C01",
          "speaker_id": "VLA-19",
          "text_vi": "Đấy, ổn rồi. Cả cái xe lẫn cái lưng tôi đều cảm ơn cậu.",
          "stage": "complete",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA19-D01",
          "speaker_id": "VLA-19",
          "text_vi": "Không sao. Tôi làm chậm chút cũng được.",
          "stage": "decline",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA19-R01",
          "speaker_id": "VLA-19",
          "text_vi": "Tôi lại phát hiện một dây buộc sờn.",
