      "traits_vi": "năng động, tò mò",
      "activity": {
        "id": "VLA18-ACT",
        "description_vi": "Kiểm kiện chuẩn bị đi liên làng cùng Ada, chưa nhận chuyến giao",
        "visible_change_vi": "Kiện được kiểm, không tự sinh làng đích hay người nhận",
        "optional": true,
        "requires_real_player_action": true
      },
      "lines": [
        {
          "id": "VLA18-I01",
          "speaker_id": "VLA-18",
          "text_vi": "Cậu thấy mấy kiện này à? Có thứ phải đi xa hơn con đường quanh làng.",
          "stage": "intro",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-Q01",
          "speaker_id": "A",
          "text_vi": "Cậu thường đi xa đến đâu?",
          "stage": "question",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-A01",
          "speaker_id": "VLA-18",
          "text_vi": "Tôi biết vài lối quen. Những chỗ xa hơn thì còn phải hỏi đường cho chắc.",
          "stage": "answer",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-O01",
          "speaker_id": "A",
          "text_vi": "Tôi giúp xem kiện có đủ không?",
          "stage": "offer",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-Y01",
          "speaker_id": "VLA-18",
          "text_vi": "Có chứ. Kiểm xem dây buộc có lỏng và nhãn có rõ không.",
          "stage": "accept",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-C01",
          "speaker_id": "VLA-18",
          "text_vi": "Ổn rồi. Chuyến đi xa bắt đầu bằng mấy việc nhỏ thế này đấy.",
          "stage": "complete",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-D01",
          "speaker_id": "VLA-18",
          "text_vi": "Không sao. Tôi và Hugo kiểm nốt được.",
          "stage": "decline",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-R01",
          "speaker_id": "VLA-18",
          "text_vi": "Tôi đang sắp lại kiện hàng cho dễ mang.",
          "stage": "revisit",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-F01",
          "speaker_id": "VLA-18",
          "text_vi": "Tôi thích những con đường chưa đi. Nhưng mỗi lần sắp rời làng, tôi vẫn muốn ngoái lại một lần.",
          "stage": "familiar",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA18-B01",
          "speaker_id": "VLA-18",
          "text_vi": "Chờ tôi ghi nốt chỗ cần chuyển đã.",
