          "status": "draft_pending_approval"
        },
        {
          "id": "VLA19-F01",
          "speaker_id": "VLA-19",
          "text_vi": "Ai cũng hỏi người đi đường thấy gì. Ít ai hỏi cái xe có về nguyên vẹn không.",
          "stage": "familiar",
          "status": "draft_pending_approval"
