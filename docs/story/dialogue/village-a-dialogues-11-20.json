        {
          "id": "VLA20-A01",
          "speaker_id": "VLA-20",
          "text_vi": "Thanh nào còn chắc, khô và không mục. Không phải cứ thấy gỗ là mang về.",
          "stage": "answer",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA20-O01",
          "speaker_id": "A",
          "text_vi": "Tôi phụ anh xếp riêng mấy thanh dùng được nhé?",
