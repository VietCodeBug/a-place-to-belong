          "status": "draft_pending_approval"
        },
        {
          "id": "VLA17-F01",
          "speaker_id": "VLA-17",
          "text_vi": "Tôi đang tập nói 'để lát nữa' thay vì nhận hết mọi việc ngay.",
          "stage": "familiar",
          "status": "draft_pending_approval"
        },
        {
          "id": "VLA17-B01",
          "speaker_id": "VLA-17",
          "text_vi": "Khoan đã, để tôi đếm đủ giỏ trước.",
          "stage": "busy",
          "status": "draft_pending_approval"
        }
