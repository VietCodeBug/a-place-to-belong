      "beats": [
        {
          "id": "LOOK",
          "player_action_vi": "Chủ động hỏi mục đích của tấm vải; kiểm mép bị kéo căng khi đặt vào chiếc giỏ dùng chung.",
          "dialogue": [
            {
              "id": "VLA13-Q1-LOOK-X1",
              "speaker_id": "VLA-13",
              "text_vi": "Tôi có thể giấu vết rách, nhưng chưa chắc dùng được lâu.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-LOOK-X2",
              "speaker_id": "A",
              "text_vi": "Tấm lót này chịu lực ở đâu?",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-LOOK-X3",
              "speaker_id": "VLA-13",
              "text_vi": "Ở chỗ gấp mép. Cậu thử đặt vào giỏ xem.",
              "status": "draft"
            }
          ]
        },
        {
          "id": "PICK",
          "player_action_vi": "Chọn đường vá có thể nhìn thấy nhưng chắc, hoặc đường vá kín kèm gia cố; có thể thử lại trước khi quyết định.",
          "dialogue": [
            {
              "id": "VLA13-Q1-PICK-X1",
              "speaker_id": "A",
              "text_vi": "Thì ra gập mép lại mới thấy chỗ dễ bung.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-PICK-X2",
              "speaker_id": "VLA-13",
              "text_vi": "Ừ. Trước giờ tôi cứ nghĩ tới chuyện nhìn cho gọn.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-PICK-X3",
              "speaker_id": "A",
              "text_vi": "Một đường chỉ thấy rõ cũng đâu có sao.",
              "status": "draft"
            }
          ]
        },
        {
          "id": "FIX",
          "player_action_vi": "Lấy chỉ, giữ mép vải, để Maeve tự khâu rồi cùng thử lại trên chiếc giỏ; chỉ sau thử mới hoàn thành.",
          "dialogue": [
            {
              "id": "VLA13-Q1-FIX-X1",
              "speaker_id": "VLA-13",
              "text_vi": "Giữ góc đó thôi, tôi sẽ khâu.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-FIX-X2",
              "speaker_id": "A",
              "text_vi": "Thử lại xem có căng quá không.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q1-FIX-X3",
              "speaker_id": "VLA-13",
              "text_vi": "Không, giờ chắc hơn rồi.",
              "status": "draft"
            }
          ]
        }
      ],
      "choices": [
        {
          "id": "strong",
          "label_vi": "Ưu tiên đường vá bền, lộ mũi",
          "outcome_vi": "Maeve nhớ A coi trọng công dụng"
        },
        {
          "id": "neat",
          "label_vi": "Vá kín và gia cố chỗ chịu lực",
          "outcome_vi": "Maeve nhớ A cân bằng hình thức và độ bền"
