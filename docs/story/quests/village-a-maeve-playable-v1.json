            {
              "id": "VLA13-Q2-SORT-X1",
              "speaker_id": "VLA-13",
              "text_vi": "Tôi cứ nhận thêm việc. Lúc trải ra mới thấy nhiều thế này.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-SORT-X2",
              "speaker_id": "A",
              "text_vi": "Cái nào đang có người cần dùng?",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-SORT-X3",
              "speaker_id": "VLA-13",
              "text_vi": "Cái ở sân chung. Hai món kia không vội.",
              "status": "draft"
            }
          ]
        },
        {
          "id": "DECIDE",
          "player_action_vi": "Chọn món ưu tiên và thỏa thuận chỉ xử lý một phần vừa sức; cùng Maeve ghi chú món để hẹn.",
          "dialogue": [
            {
              "id": "VLA13-Q2-DECIDE-X1",
              "speaker_id": "A",
              "text_vi": "Mình có thể hẹn vài món sang buổi khác.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-DECIDE-X2",
              "speaker_id": "VLA-13",
              "text_vi": "Tôi ngại nói câu đó.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-DECIDE-X3",
              "speaker_id": "A",
              "text_vi": "Nhưng nói rõ còn hơn hứa rồi không làm kịp.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-DECIDE-X4",
              "speaker_id": "VLA-13",
              "text_vi": "Ừ. Tôi thử nhé.",
              "status": "draft"
            }
          ]
        },
        {
          "id": "DO",
          "player_action_vi": "Giúp chuẩn bị phần vải cần sửa, cất đúng từng nhóm và để Maeve tự kết thúc buổi làm việc.",
          "dialogue": [
            {
              "id": "VLA13-Q2-DO-X1",
              "speaker_id": "VLA-13",
              "text_vi": "Cái bàn bây giờ trống hơn rồi.",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-DO-X2",
              "speaker_id": "A",
              "text_vi": "Hôm nay làm thêm không?",
              "status": "draft"
            },
            {
              "id": "VLA13-Q2-DO-X3",
              "speaker_id": "VLA-13",
              "text_vi": "Không. Để buổi sau.",
              "status": "draft"
            }
          ]
        }
      ],
