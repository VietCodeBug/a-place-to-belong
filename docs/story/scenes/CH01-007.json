  "dialogue_lines": [
    {
      "id": "CH01007-G01",
      "speaker": "GARDENER_01",
      "text_vi": "Ồ, khách mới à? Tôi không nhận ra cậu.",
      "type": "intro",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G02",
      "speaker": "A",
      "text_vi": "Tôi đi theo lối mòn từ phía rừng.",
      "type": "intro",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G03",
      "speaker": "GARDENER_01",
      "text_vi": "Cứ nhìn quanh thoải mái. Chỉ cẩn thận mấy luống cây mới lên thôi.",
      "type": "intro",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G04",
      "speaker": "A",
      "text_vi": "Ở đây mọi người sống gần nhau à?",
      "type": "ask_area",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G05",
      "speaker": "GARDENER_01",
      "text_vi": "Ừ. Không phải lúc nào cũng rảnh để trò chuyện đâu, nhưng cần thì cứ lên tiếng.",
      "type": "ask_area",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G06",
      "speaker": "A",
      "text_vi": "Cây mới trồng à?",
      "type": "ask_activity",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G07",
      "speaker": "GARDENER_01",
      "text_vi": "Đúng. Đang xem chỗ nào cần thêm nước.",
      "type": "ask_activity",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G08",
      "speaker": "A",
      "text_vi": "Tôi giúp được gì không?",
      "type": "offer_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G09",
      "speaker": "GARDENER_01",
      "text_vi": "Nếu muốn thì cậu tưới giúp mấy luống ở mép này. Đừng tưới ngập quá là được.",
      "type": "offer_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G10",
      "speaker": "GARDENER_01",
      "text_vi": "Được đấy. Cảm ơn cậu.",
      "type": "help_completed",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G11",
      "speaker": "GARDENER_01",
      "text_vi": "À, lại là cậu. Mấy luống lúc nãy ổn rồi.",
      "type": "repeat_after_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-G12",
      "speaker": "GARDENER_01",
      "text_vi": "Cậu còn muốn hỏi gì à?",
      "type": "repeat_no_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-R01",
      "speaker": "REPAIRER_01",
      "text_vi": "Cẩn thận. Cái chốt này cứ trượt khỏi tay tôi.",
      "type": "intro",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-R02",
      "speaker": "A",
      "text_vi": "Có cần tôi giữ giúp không?",
      "type": "offer_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-R03",
      "speaker": "REPAIRER_01",
      "text_vi": "Ừ, giữ giúp một lát. Tôi thử lại lần nữa.",
      "type": "offer_help",
      "status": "draft_not_approved"
    },
    {
      "id": "CH01007-R04",
      "speaker": "REPAIRER_01",
      "text_vi": "Đó. Cuối cùng cũng chịu đứng yên. Cảm ơn.",
      "type": "help_completed",
      "status": "draft_not_approved"
    }
  ],
