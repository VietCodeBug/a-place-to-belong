  "beats": [
    {
      "id": "CH01004-B01",
      "type": "environmental_story",
      "content_vi": "A rời khoảng đất Thomas đang đốn củi; tiếng rìu nhỏ dần sau lưng. Nếu chưa nói chuyện với Thomas, không phát thoại."
    },
    {
      "id": "CH01004-B02",
      "type": "environmental_story",
      "content_vi": "Đất trên lối mòn có những chỗ nén và dấu người thường qua. Không thêm câu chuyện về người đi qua."
    },
    {
      "id": "CH01004-B03",
      "type": "discovery",
      "content_vi": "A nhận ra một khoảng nghỉ và ghế gỗ cũ có thanh ván mới hơn, như đã được ai đó chăm sóc.",
      "set_flags": [
        "ch01_rest_spot_discovered"
      ]
    },
    {
      "id": "CH01004-B04",
      "type": "optional_interaction",
      "content_vi": "Người chơi có thể xem ván ghế hoặc ngồi nghỉ, không bắt buộc.",
      "interactions": [
        "inspect_repaired_plank",
        "sit_on_bench"
      ]
    },
    {
      "id": "CH01004-B05",
      "type": "free_exploration",
      "content_vi": "Lối mòn vẫn đi tiếp. Người chơi có thể tiến sâu hơn, quay lại Thomas hoặc về căn nhà. Không tạo objective mới."
    }
  ],
