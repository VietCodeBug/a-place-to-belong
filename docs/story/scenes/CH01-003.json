      "type": "environmental_story",
      "description_vi": "Dấu lối mòn và tiếng bổ củi dẫn A tới bìa rừng.",
      "dialogue_group": null
    },
    {
      "id": "CH01003-B02",
      "type": "npc_daily_life",
      "description_vi": "Thomas đang đốn củi, chỉ dừng khi A đến gần và muốn nói chuyện.",
      "dialogue_group": null
    },
    {
      "id": "CH01003-B03",
      "type": "intro_dialogue",
      "description_vi": "Người chơi chủ động bắt chuyện với Thomas.",
      "dialogue_group": "THOMAS_INTRO"
    },
    {
      "id": "CH01003-B04",
      "type": "optional_dialogue",
      "description_vi": "Người chơi có thể hỏi nhà / người sống quanh vùng.",
      "dialogue_groups": [
        "THOMAS_SMALL_TALK",
        "THOMAS_ABOUT_HOUSE",
        "THOMAS_ABOUT_PEOPLE"
      ]
    },
    {
      "id": "CH01003-B05",
      "type": "player_guidance",
      "description_vi": "Có thể hỏi Thomas về hướng đi; chỉ nhận gợi ý mềm.",
      "dialogue_group": "THOMAS_DIRECTIONS"
    },
    {
      "id": "CH01003-B06",
      "type": "free_exploration",
      "description_vi": "Tiếp tục theo đường hoặc quay lại nhà, không ép chọn.",
      "dialogue_group": null
    }
  ],
  "characters": [
    "A",
