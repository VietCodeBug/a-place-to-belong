  ],
  "transcript_v1": {
    "status": "accepted_by_creator",
    "language": "vi",
    "speaker_ids_are_english": true,
    "notes": "Original accepted dialogue preserved. A is placeholder. Split into optional topic groups for play.",
    "lines": [
      {
        "id": "CH01003-L01",
        "speaker": "THOMAS",
        "text_vi": "Ồ...",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L02",
        "speaker": "THOMAS",
        "text_vi": "Có người từ căn nhà trên kia xuống à.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L03",
        "speaker": "A",
        "text_vi": "Xin lỗi... tôi không chắc mình đang ở đâu.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L04",
        "speaker": "THOMAS",
        "text_vi": "Nhìn là biết.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L05",
        "speaker": "THOMAS",
        "text_vi": "Cậu trông như người vừa thức dậy mà bị quăng thẳng vào rừng vậy.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L06",
        "speaker": "A",
        "text_vi": "... Có lẽ đúng là như thế.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L07",
        "speaker": "THOMAS",
        "text_vi": "Thomas.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L08",
        "speaker": "THOMAS",
        "text_vi": "Còn cậu?",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L09",
        "speaker": "A",
        "text_vi": "A...",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L10",
        "speaker": "A",
        "text_vi": "Ít nhất, tôi nghĩ vậy.",
        "status": "accepted_dialogue_v1",
        "delivery": "intro"
      },
      {
        "id": "CH01003-L11",
        "speaker": "THOMAS",
        "text_vi": "‘Ít nhất, tôi nghĩ vậy’ hả.",
        "status": "accepted_dialogue_v1",
        "delivery": "optional_comment"
      },
      {
        "id": "CH01003-L12",
        "speaker": "THOMAS",
        "text_vi": "Ừ, ở đây đôi khi người ta cũng phải mất một lúc mới nhớ ra vài thứ.",
        "status": "accepted_dialogue_v1",
        "delivery": "optional_comment"
      },
      {
        "id": "CH01003-L13",
        "speaker": "A",
        "text_vi": "Ông biết căn nhà đó sao?",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L14",
        "speaker": "THOMAS",
        "text_vi": "Biết.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L15",
        "speaker": "THOMAS",
        "text_vi": "Nó đã ở đó từ lâu rồi.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L16",
        "speaker": "THOMAS",
        "text_vi": "Lâu đủ để gỗ cũ đi, cỏ mọc cao lên, mà vẫn chưa chịu đổ.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L17",
        "speaker": "A",
        "text_vi": "Tôi cảm thấy... kỳ lạ.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L18",
        "speaker": "A",
        "text_vi": "Như thể nơi đó rất lạ, nhưng lại không hoàn toàn xa lạ.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L19",
        "speaker": "THOMAS",
        "text_vi": "Vậy thì chắc cậu nên ở lại thêm một chút.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L20",
        "speaker": "THOMAS",
        "text_vi": "Có những nơi phải sống cùng nó một thời gian, mới hiểu được mình đang cảm thấy gì.",
        "status": "accepted_dialogue_v1",
        "delivery": "house_topic"
      },
      {
        "id": "CH01003-L21",
        "speaker": "A",
        "text_vi": "Ở đây còn ai khác không?",
        "status": "accepted_dialogue_v1",
        "delivery": "people_topic"
      },
      {
        "id": "CH01003-L22",
        "speaker": "THOMAS",
        "text_vi": "Có chứ.",
        "status": "accepted_dialogue_v1",
        "delivery": "people_topic"
      },
      {
        "id": "CH01003-L23",
        "speaker": "THOMAS",
        "text_vi": "Không đông, nhưng cũng chẳng ít đến mức chỉ còn mình tôi với đống củi này.",
        "status": "accepted_dialogue_v1",
        "delivery": "people_topic"
      },
      {
        "id": "CH01003-L24",
        "speaker": "THOMAS",
        "text_vi": "Nếu cậu định ở căn nhà đó, sớm muộn gì cậu cũng sẽ gặp mọi người thôi.",
        "status": "accepted_dialogue_v1",
        "delivery": "people_topic"
      },
      {
        "id": "CH01003-L25",
        "speaker": "THOMAS",
        "text_vi": "Nếu cậu đi tiếp con đường này, sẽ thấy thêm vài dấu hiệu của người sống.",
        "status": "accepted_dialogue_v1",
        "delivery": "guidance_topic"
      },
      {
        "id": "CH01003-L26",
        "speaker": "THOMAS",
        "text_vi": "Nhưng trước hết...",
        "status": "accepted_dialogue_v1",
        "delivery": "guidance_topic"
      },
      {
        "id": "CH01003-L27",
        "speaker": "STAGE",
        "text_vi": "Thomas nhìn về phía căn nhà trên đồi.",
        "status": "accepted_dialogue_v1",
        "delivery": "guidance_topic"
      },
      {
        "id": "CH01003-L28",
        "speaker": "THOMAS",
        "text_vi": "Có lẽ cậu nên bắt đầu từ chỗ đó.",
        "status": "accepted_dialogue_v1",
        "delivery": "guidance_topic"
      },
      {
        "id": "CH01003-L29",
        "speaker": "THOMAS",
        "text_vi": "Dù sao, một mái nhà cũng nên được thắp sáng trước khi chủ của nó đi lang thang quá xa.",
        "status": "accepted_dialogue_v1",
        "delivery": "guidance_topic"
      }
    ]
  },
