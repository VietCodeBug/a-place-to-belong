  "dialogue_draft": [
    {
      "id": "DEL-ADA-01",
      "speaker_id": "VLA-18",
      "text_vi": "Mấy món này không phải để trong làng đâu. Chúng phải đến tay người ở xa hơn.",
      "purpose": "optional_conversation",
      "status": "draft"
    },
    {
      "id": "DEL-A-02",
      "speaker_id": "A",
      "text_vi": "Cậu thường đi sang làng khác à?",
      "purpose": "optional_question",
      "status": "draft"
    },
    {
      "id": "DEL-ADA-03",
      "speaker_id": "VLA-18",
      "text_vi": "Có lúc. Tôi nhớ đường khá tốt, nhưng vẫn có những lối chưa từng thử.",
      "purpose": "character_response",
      "status": "draft"
    },
    {
      "id": "DEL-HUGO-01",
      "speaker_id": "VLA-19",
      "text_vi": "Đi đường xa thì buộc chắc một chút. Không ai thích tới nơi rồi mới biết thiếu đồ.",
      "purpose": "preparation",
      "status": "draft"
    },
    {
      "id": "DEL-ADA-04",
      "speaker_id": "VLA-18",
      "text_vi": "Tôi có một kiện cần gửi sang bên kia. Cậu có muốn nhận giúp chuyến này không?",
      "purpose": "request_offered_if_route_defined",
      "status": "draft"
    },
    {
      "id": "DEL-ADA-05",
      "speaker_id": "VLA-18",
      "text_vi": "Được thôi. Tôi sẽ thu xếp cách khác.",
      "purpose": "decline",
      "status": "draft"
    },
    {
      "id": "DEL-RECIPIENT-01",
      "speaker_id": "RECIPIENT_TBD",
      "text_vi": "À, đúng món tôi đang đợi. Cảm ơn cậu đã mang tới.",
      "purpose": "delivery_completion",
      "status": "draft"
    }
  ],
