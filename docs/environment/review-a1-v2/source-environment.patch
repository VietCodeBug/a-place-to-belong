+		for z in [-depth*0.44, depth*0.44]:
+			S.box(facade,Vector3(z,height*0.5,0),Vector3(0.16,height,0.13),beam)
+		S.box(facade,Vector3(0,height-0.44,0),Vector3(depth,0.14,0.14),beam)
+		window(facade,Vector3(-0.68,1.83,-0.015),0.74)
+		if index in [2,4]:
+			window(facade,Vector3(0.86,2.69,-0.015),0.67)
+	lantern(house, Vector3(doorway+0.90,1.95,front-0.32))
+	var door := house.to_global(Vector3(doorway,0,front-1.12))
+	var street := Vector3(L.valley_path(door.z),0,door.z-0.8)
+	paving(Vector2(door.x, door.z),Vector2(street.x,street.z),1.13)
+	var fence_at := house.to_global(Vector3(width*0.33,0,front-1.82))
+	var garden := ground(fence_at.x,fence_at.z)
+	if index % 2 == 0 and absf(garden.x-L.valley_path(garden.z))>2.5:
+		A.place(self,"fantasy-town","fence",garden,0.86,house.rotation.y)
+		A.place(self,"nature","log_stack", garden + Vector3(-0.64,0.0,0.58),0.68,house.rotation.y)
+
+func paving(a: Vector2, b: Vector2, width: float) -> void:
+	var surface := SurfaceTool.new()
+	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var right := (b-a).normalized().orthogonal()
+	var steps := maxi(2,ceili(a.distance_to(b)*3.0))
+	for i in range(steps):
+		var l := a.lerp(b,float(i)/steps)
+		var r := a.lerp(b,float(i+1)/steps)
+		for p in [l-right*width,l+right*width,r-right*width,l+right*width,r+right*width,r-right*width]:
+			var lateral: float = (p-a).dot(right)
+			surface.set_uv(Vector2(lateral,width-0.24))
+			surface.add_vertex(ground(p.x,p.y)+Vector3.UP*0.035)
+	surface.generate_normals()
+	var path := S.mesh(self,surface.commit(),Vector3.ZERO,"998368")
+	var paint := ShaderMaterial.new()
+	paint.shader = preload("res://shaders/forest_path.gdshader")
+	path.material_override = paint
+	path.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+
+func detail_slices() -> void:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 92714
+	var anchors := [Vector2(-22,50),Vector2(-13,52),Vector2(-27,57),Vector2(-31,50),
+		Vector2(-10,63),Vector2(-23,66),Vector2(12,61),Vector2(11,84),Vector2(-10,102),
+		Vector2(13,105),Vector2(0,112),Vector2(12,115),Vector2(4,124),Vector2(18,121)]
+	for cluster in anchors.size():
+		var center: Vector2 = anchors[cluster]
+		for i in range(13):
+			var p := center + Vector2(rng.randf_range(-4,4),rng.randf_range(-3,3))
+			if absf(p.x-L.valley_path(p.y)) < 2.35:
+				continue
+			var at := ground(p.x,p.y)
+			if i % 6 == 0:
+				A.place(self,"quaternius","Rock_Moss_1",at,rng.randf_range(0.27,0.83),rng.randf_range(0,TAU))
+			elif i % 4 == 0:
+				A.place(self,"nature", ["flower_purpleB","flower_yellowA","flower_redC"][cluster%3],at,0.35+i*0.013,i)
+			else:
+				A.place(self,"nature","grass_leafs" if i%3==0 else "grass_large",at,rng.randf_range(0.21,0.50),i)
+	for i in range(8):
+		var x := -30.0 + 3.3 * i
+		var z := 53.5 + 5.2 * sin(i*2.0)
+		if L.in_overlook_view(x, z):
+			continue
+		A.place(self,"quaternius","BirchTree_Autumn_3" if i%3==0 else "PineTree_2",
+			ground(x,z),7.5+float(i%4)*1.75,i, "autumn" if i%3==0 else "sage")
+	for side in [-1, 1]:
+		for i in range(13):
+			var x := -25.0 + i * 3.85
+			if absf(x) < 3.2:
+				continue
+			var at := ground(x,L.river_center(x)+side*(5.7+0.42*sin(i*2.01)))
+			A.place(self,"nature","rock_smallC",at,0.34+0.38*absf(sin(i)),i,"warm_stone")
+			A.place(self,"nature","grass_leafs",at+Vector3(0.53,0,0.17),0.49,i)
+
+func register_canopy(tree: Node3D, broadleaf: bool) -> void:
+	for child in tree.find_children("*","MeshInstance3D",true,false):
+		var visual := child as MeshInstance3D
+		for i in range(visual.mesh.get_surface_count()):
+			var source := visual.get_active_material(i) as StandardMaterial3D
+			if source == null:
+				continue
+			var name := source.resource_name.to_lower()
+			if not ("leaf" in name or "leaves" in name or name in ["grass","green","orange","lightorange"]):
+				continue
+			var key := "%d:%d" % [source.get_instance_id(), int(broadleaf)]
+			if not canopy_materials.has(key):
+				canopy_materials[key] = [source.duplicate(), source.albedo_color, broadleaf]
+			visual.set_surface_override_material(i, canopy_materials[key][0])
+
+func set_season_palette(season: int) -> void:
+	var terrain := get_parent().find_child("ContinuousMap01Terrain",true,false) as MeshInstance3D
+	if terrain != null:
+		(terrain.material_override as ShaderMaterial).set_shader_parameter("a1_season", season)
+	for entry in canopy_materials.values():
+		var material: StandardMaterial3D = entry[0]
+		var original: Color = entry[1]
+		var broadleaf: bool = entry[2]
+		match season:
+			1: material.albedo_color = original.lerp(Color("A1B969"), 0.73 if broadleaf else 0.30)
+			2: material.albedo_color = original.lerp(Color("68894D"), 0.80 if broadleaf else 0.26)
+			3: material.albedo_color = original.lerp(Color("A9B8BA"), 0.72 if broadleaf else 0.51)
+			_: material.albedo_color = original
+	for roof in roofs:
+		roof.set_shader_parameter("snow_cover", 0.91 if season == 3 else 0.0)
+
+func register_tiled_roof(material: ShaderMaterial) -> void:
+	roofs.append(material)
