+	for i in range(190):
+		var z := rng.randf_range(26, 143)
+		var x := rng.randf_range(-39, 39)
+		var near_water := absf(z - L.river_center(x)) < 8.4
+		var path_gap := absf(x - L.valley_path(z))
+		if near_water or L.in_overlook_view(x, z) or path_gap < 4.8 or (z > 98 and x > -11 and x < 28):
+			continue
+		if z > 55 and z < 95 and absf(x) < 11:
+			continue
+		var at := ground(x, z)
+		var broadleaf := i % 4 == 0
+		var kind: String = "tree_oak_fall" if broadleaf else PINE[i % 3]
+		var role := "autumn" if broadleaf else ("cedar" if i % 2 == 0 else "spruce")
+		var tree := A.place(self, "nature", kind, at, rng.randf_range(5.7, 13.0), rng.randf_range(0, TAU), role)
+		if z >= 37.0:
+			register_canopy(tree, broadleaf)
+		S.box(self, at + Vector3.UP * 1.5, Vector3(0.8, 3, 0.8), "FFFFFF", true).hide()
+	for i in range(132):
+		var z := rng.randf_range(29, 137)
+		var x := L.valley_path(z) + rng.randf_range(3.0, 12.0) * (-1.0 if i % 2 == 0 else 1.0)
+		if absf(z - L.river_center(x)) < 6.2:
+			continue
+		var at := ground(x, z)
+		if i % 5 == 0:
+			facet(self, at + Vector3.UP * 0.27, Vector3(1.04, 0.74, 0.90), "81877B")
+		else:
+			facet(self, at + Vector3.UP * 0.17, Vector3(0.53, 0.42, 0.50), ["708650", "8B9E5B", "5B794B"][i % 3])
