+
+static func envelope(site: Node3D, parent: Node3D, span: Vector2, eave: float, rise: float,
+		peak: float, pigment: String, solid := true) -> void:
+	var wall := SurfaceTool.new()
+	wall.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var half := span * 0.5
+	var profile := [Vector2(-half.x,-0.43),Vector2(half.x,-0.43),Vector2(half.x,eave),
+		Vector2(peak,eave+rise),Vector2(-half.x,eave)]
+	for z in [-half.y,half.y]:
+		for i in range(1,4):
+			var a := Vector3(profile[0].x,profile[0].y,z)
+			var b := Vector3(profile[i].x,profile[i].y,z)
+			var c := Vector3(profile[i+1].x,profile[i+1].y,z)
+			for p in ([a,b,c] if z < 0.0 else [a,c,b]):
+				wall.add_vertex(p)
+	for side in [-1,1]:
+		var x: float = side*half.x
+		var a := Vector3(x,-0.43,-half.y)
+		var b := Vector3(x,eave,-half.y)
+		var c := Vector3(x,eave,half.y)
+		var d := Vector3(x,-0.43,half.y)
+		if side < 0:
+			quad(wall,a,b,c,d)
+		else:
+			quad(wall,d,c,b,a)
+	wall.generate_normals()
+	site.finish(S.mesh(parent,wall.commit(),Vector3.ZERO,pigment),pigment)
+	if solid:
+		S.box(parent,Vector3(0,eave*0.5-0.12,0),Vector3(span.x,eave+0.24,span.y),pigment,true).hide()
+
+static func quad(surface: SurfaceTool,a: Vector3,b: Vector3,c: Vector3,d: Vector3) -> void:
+	for vertex in [a,b,c,a,c,d]:
+		surface.add_vertex(vertex)
+
+static func roof(site: Node3D, parent: Node3D, span: Vector2, eave: float, rise: float,
+		peak: float, pigment: String) -> void:
+	var tiles := SurfaceTool.new()
+	tiles.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var half_z := span.y*0.5+0.34
+	var tint := Color(pigment)
+	for side in [-1,1]:
+		var ridge := Vector3(peak,eave+rise,0)
+		var lip := Vector3(side*(span.x*0.5+0.30),eave-0.11,0)
+		var rows := ceili(ridge.distance_to(lip)/0.29)
+		var columns := ceili(half_z*2.0/0.30)
+		var a0 := ridge + Vector3(0,0.020,-half_z)
+		var b0 := ridge + Vector3(0,0.020,half_z)
+		var c0 := lip + Vector3(0,0.020,half_z)
+		var d0 := lip + Vector3(0,0.020,-half_z)
+		tiles.set_color(tint.darkened(0.19))
+		if side > 0:
+			quad(tiles,d0,c0,b0,a0)
+		else:
+			quad(tiles,a0,b0,c0,d0)
+		for j in range(rows):
+			var high := ridge.lerp(lip,float(j)/rows)
+			var low := ridge.lerp(lip,float(j+1)/rows)
+			for i in range(columns+1):
+				var width := 2.0*half_z/columns
+				var z0 := clampf(-half_z+(i-0.5*float(j%2))*width,-half_z,half_z)
+				var z1 := clampf(z0+width-0.009,-half_z,half_z)
+				if z1-z0 < 0.03:
+					continue
+				var a := high+Vector3(0,0.035,z0)
+				var b := high+Vector3(0,0.035,z1)
+				var c := low+Vector3(0,0.064,z1)
+				var d := low+Vector3(0,0.064,z0)
+				tiles.set_color(tint.lightened(sin(i*4.4+j*7.8)*0.081))
+				if side > 0:
+					quad(tiles,d,c,b,a)
+				else:
+					quad(tiles,a,b,c,d)
+				quad(tiles,d,c,c-Vector3.UP*0.063,d-Vector3.UP*0.063)
+		for z in [-half_z,half_z]:
+			S.beam(parent,ridge+Vector3(0,0.025,z),lip+Vector3(0,0.025,z),0.17,WOOD)
+		S.beam(parent,lip-Vector3.BACK*half_z,lip+Vector3.BACK*half_z,0.16,WOOD)
+	S.beam(parent,Vector3(peak,eave+rise+0.07,-half_z),Vector3(peak,eave+rise+0.07,half_z),0.17,pigment)
+	tiles.generate_normals()
+	var roof_mesh := S.mesh(parent,tiles.commit(),Vector3.ZERO,pigment)
+	var material := ShaderMaterial.new()
+	material.shader = preload("res://shaders/a1_architecture.gdshader")
+	material.set_shader_parameter("tiled_mesh",true)
+	roof_mesh.material_override = material
+	site.register_tiled_roof(material)
+
+static func base(parent: Node3D, span: Vector2) -> void:
+	for edge in [-1,1]:
+		for i in range(9):
+			var x := (i-4)*span.x/9.0
+			var block := S.box(parent,Vector3(x,-0.12,edge*span.y*0.5),
+				Vector3(span.x/9.0-0.021,0.53+0.07*sin(i),0.29),["8F8375","9E9786","7E7F73"][i%3])
+			block.rotation.y = sin(i*5.0)*0.05
+
+static func facade(site: Node3D, parent: Node3D, span: Vector2, eave: float,
+		rise: float, peak: float, doorway: float) -> void:
+	var z := -span.y*0.5-0.045
+	var half := span.x*0.5
+	for x in [-half+0.08,half-0.08]:
+		S.beam(parent,Vector3(x,0.15,z),Vector3(x,eave,z),0.21,WOOD)
+	for y in [0.33,eave-0.12]:
+		S.beam(parent,Vector3(-half,y,z),Vector3(half,y,z),0.17,WOOD)
+	for side in [-1,1]:
+		var corner: float = side*(half-0.1)
+		S.beam(parent,Vector3(corner,eave-0.19,z),Vector3(peak,eave+rise-0.11,z),0.16,WOOD)
+		S.beam(parent,Vector3(corner,eave-0.17,z),Vector3(corner-side*0.70,eave-0.87,z),0.12,WOOD)
+		var x: float = side*(half-0.81)
+		if absf(x-doorway)<0.85:
+			continue
+		site.window(parent,Vector3(x,1.64,z-0.08),0.75)
+		for shutter in [-1,1]:
+			S.box(parent,Vector3(x+shutter*0.52,1.63,z-0.18),Vector3(0.23,0.96,0.08),"617368")
+		S.box(parent,Vector3(x,1.05,z-0.22),Vector3(1.02,0.22,0.35),"7D5740")
+		for flower in range(3):
+			A.place(parent,"nature","flower_purpleB" if side<0 else "flower_redC",
+				Vector3(x+(flower-1)*0.27,1.17,z-0.25),0.24,flower)
+	site.window(parent,Vector3(peak,eave+rise*0.32,z-0.07),0.59)
+	for side in [-1,1]:
+		var end := Node3D.new()
+		parent.add_child(end)
+		end.position.x = side*half
+		end.rotation.y = -side*PI*0.5
+		for p in [-span.y*0.42,span.y*0.42]:
+			S.beam(end,Vector3(p,0.21,-0.04),Vector3(p,eave,-0.04),0.14,WOOD)
+		S.beam(end,Vector3(-span.y*0.48,eave-0.15,-0.05),Vector3(span.y*0.48,eave-0.15,-0.05),0.14,WOOD)
+		site.window(end,Vector3(0.45,1.72,-0.09),0.70)
+		if eave > 4.0:
+			site.window(end,Vector3(-0.56,3.69,-0.09),0.76)
+
+static func entry(site: Node3D, parent: Node3D, door: Vector3, kind: int, pigment: String) -> void:
+	var width := 2.95 if kind == 3 else (3.45 if kind == 2 else 2.39)
+	var front := door.z
