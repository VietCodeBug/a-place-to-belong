+	var heights := [3.4, 3.15, 4.3, 3.5, 4.0, 3.30]
+	var depths := [4.5, 4.9, 5.2, 5.6, 4.8, 4.4]
+	var width: float = widths[index]
+	var height: float = heights[index]
+	var depth: float = depths[index]
+	var pitch := 0.48 + 0.07 * (index % 3)
