+			S.beam(parent,Vector3(x,0.85,front-1.20),Vector3(x,0.85,front-0.24),0.11,WOOD)
+	A.place(parent,"fantasy-town","lantern",door+Vector3(width*0.34,1.88,-0.37),0.43)
+	if kind == 2:
+		A.place(parent,"fantasy-town","fence",door+Vector3(2.79,0,-2.20),0.85)
+		A.place(parent,"nature","log_stack",door+Vector3(2.65,0,-0.72),0.71)
+
+static func street(site: Node3D) -> void:
+	var stones := SurfaceTool.new()
+	stones.begin(Mesh.PRIMITIVE_TRIANGLES)
+	stones.set_smooth_group(-1)
+	for row in range(37):
+		var z := 102.0+row*0.87
+		var count := 3 if row%4 != 0 else 2
+		for i in range(count):
+			var x := L.valley_path(z)+(i-(count-1)*0.5)*1.02+sin(row*4.17+i)*0.14
+			var center := Vector2(x,z+sin(i*7.1+row*1.9)*0.075)
+			var size := Vector2(0.43+0.07*sin(row+i),0.30+0.04*cos(row*3+i))
+			var perimeter := PackedVector3Array()
+			for edge in range(7):
+				var angle := edge*TAU/7.0+cos(row*2.0+i)*0.34
+				var p := center+Vector2(cos(angle),sin(angle))*size*(0.87+0.13*sin(edge*9.2+i))
+				perimeter.append(Vector3(p.x,L.height_at(p.x,p.y)+0.026,p.y))
+			var top := Vector3(center.x,L.height_at(center.x,center.y)+0.028,center.y)
+			for edge in range(7):
+				stones.set_color(Color("A29682").lightened(0.12*sin(row*7.7+i)))
+				var a := perimeter[edge]
+				var b := perimeter[(edge+1)%7]
+				for v in [top,a,b]:
+					stones.add_vertex(v)
+				quad(stones,a,a-Vector3.UP*0.06,b-Vector3.UP*0.06,b)
+	stones.generate_normals()
+	var mesh := S.mesh(site,stones.commit(),Vector3.ZERO,"A29682")
+	var material := StandardMaterial3D.new()
+	material.vertex_color_use_as_albedo = true
+	material.roughness = 0.97
+	mesh.material_override = material
diff --git a/scripts/ui/a1_map.gd b/scripts/ui/a1_map.gd
new file mode 100644
index 0000000..617a1c1
--- /dev/null
+++ b/scripts/ui/a1_map.gd
@@ -0,0 +1,90 @@
+extends Control
+
+const L = preload("res://scripts/world/landscape.gd")
+const MAPS = preload("res://scripts/story/map_flow.gd")
+const PLACES := [
+	[Vector2(0, -3), "Forest clearing", "Khoảng rừng"],
+	[Vector2(-6.85, 17.8), "Thomas", "Thomas"],
+	[Vector2(-22.5, 50), "Valley overlook", "Điểm ngắm thung lũng"],
+	[Vector2(0, 74), "River bridge", "Cầu qua sông"],
+	[Vector2(8, 117), "Village", "Làng A"],
+]
+const INK := Color("3e5145")
+var player: Node3D
+var visited: Dictionary = {}
+var zoom := 1.0
+var pan := Vector2.ZERO
+
+func _ready() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	hide()
+
+func _process(_delta: float) -> void:
+	var at := Vector2(player.position.x, player.position.z)
+	for place in PLACES:
+		if at.distance_to(place[0]) < 10.0:
+			visited[place[0]] = true
+	if visible:
+		queue_redraw()
+
+func point(at: Vector2) -> Vector2:
+	return size * 0.5 + pan + Vector2(at.x, 59.0 - at.y) * map_scale()
+
+func map_scale() -> float:
+	return minf(size.x / 150.0, size.y / 202.0) * zoom
+
+func center_on_player() -> void:
+	pan = -Vector2(player.position.x, 59.0 - player.position.z) * map_scale()
+
+func _gui_input(event: InputEvent) -> void:
+	if event is InputEventMouseMotion and (event.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
+		pan += event.relative
+	elif event is InputEventMouseButton and event.pressed:
+		if event.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
+			var old := zoom
+			zoom = clampf(zoom + (0.18 if event.button_index == MOUSE_BUTTON_WHEEL_UP else -0.18), 0.65, 3.2)
+			var from_center: Vector2 = event.position - size * 0.5
+			pan = from_center + (pan - from_center) * (zoom / old)
+		elif event.button_index == MOUSE_BUTTON_LEFT and Rect2(size.x - 191, 20, 164, 39).has_point(event.position):
+			center_on_player()
+
+func _draw() -> void:
+	var paper := Color("e6d7ad")
+	draw_rect(Rect2(Vector2.ZERO, size), paper)
+	for z in range(-24, L.VALLEY_END, 4):
+		var span := 24 if z < 24 else L.VALLEY_HALF_WIDTH
+		for x in range(-span, span, 4):
+			var elevation := L.height_at(x + 2.0, z + 2.0)
+			var color := Color("b9bc8c").lerp(Color("899b77"), clampf(elevation / 15.0, 0, 1))
+			draw_rect(Rect2(point(Vector2(x, z + 4)), Vector2.ONE * (4.0 * map_scale() + 0.5)), color)
+	var river := PackedVector2Array()
+	for x in range(-40, 41, 2):
+		river.append(point(Vector2(x, L.river_center(x))))
+	draw_polyline(river, Color("729d9c"), 8.0 * map_scale(), true)
+	var trail := PackedVector2Array()
+	for z in range(5, 140, 2):
+		trail.append(point(Vector2(L.valley_path(z) if z > 24 else ClearingLayout.path_center(z), z)))
+	draw_polyline(trail, Color("f0d7a8"), 2.2 * map_scale(), true)
+	draw_line(point(Vector2(0, 67)), point(Vector2(0, 81)), Color("795d45"), 3.5 * map_scale(), true)
+	var font := get_theme_default_font()
+	for place in PLACES:
+		var at := point(place[0])
+		var known := visited.has(place[0])
+		draw_circle(at, 5.0, INK if known else Color("8f9374"))
+		if known:
+			draw_string(font, at + Vector2(10, 5), MAPS.text(place[1], place[2]), HORIZONTAL_ALIGNMENT_LEFT, -1, 15, INK)
+	var self_at := point(Vector2(player.position.x, player.position.z))
+	var facing: Vector3 = -player.get_node("Model").global_basis.z
+	var heading := Vector2(facing.x, -facing.z).normalized()
+	draw_circle(self_at, 7.7, Color("9b4d3c"))
+	draw_line(self_at, self_at + heading * 16.0, Color("9b4d3c"), 4.0, true)
+	draw_rect(Rect2(Vector2.ZERO, Vector2(size.x, 72)), paper)
+	draw_rect(Rect2(Vector2(0, size.y - 48), Vector2(size.x, 48)), paper)
+	draw_string(font, Vector2(27, 43), MAPS.text("A1  ·  River valley", "A1  ·  Thung lũng ven sông"),
+		HORIZONTAL_ALIGNMENT_LEFT, -1, 25, INK)
+	draw_rect(Rect2(size.x - 191, 20, 164, 39), Color("c8bc96"))
+	draw_string(font, Vector2(size.x - 176, 44), MAPS.text("Find me  ·  Home", "Về vị trí  ·  Home"),
+		HORIZONTAL_ALIGNMENT_LEFT, -1, 15, INK)
+	draw_string(font, Vector2(27, size.y - 18), MAPS.text("Drag  ·  Scroll to zoom  ·  M / Esc to close",
+		"Kéo để di chuyển  ·  Cuộn để thu phóng  ·  M / Esc để đóng"), HORIZONTAL_ALIGNMENT_LEFT, -1, 15, INK)
diff --git a/shaders/a1_architecture.gdshader b/shaders/a1_architecture.gdshader
new file mode 100644
index 0000000..965108b
--- /dev/null
+++ b/shaders/a1_architecture.gdshader
@@ -0,0 +1,40 @@
+shader_type spatial;
+render_mode diffuse_burley;
+
+uniform vec4 pigment : source_color = vec4(0.55, 0.36, 0.25, 1.0);
+uniform bool shingles = false;
+uniform bool tiled_mesh = false;
+uniform float snow_cover = 0.0;
+varying vec3 local;
+varying float top_side;
+
+float hash(vec2 p) {
+	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
+}
+
+void vertex() {
+	local = VERTEX;
+	top_side = max(NORMAL.y, 0.0);
+}
+
+void fragment() {
+	vec2 uv = abs(NORMAL.z) > 0.55 ? local.xy : local.zy;
+	float tone = sin(uv.x * 11.0 + sin(uv.y * 6.2)) * sin(uv.y * 9.1) * 0.026;
+	float pores = hash(floor(uv * 85.0)) - 0.5;
+	vec3 color = (tiled_mesh ? COLOR.rgb : pigment.rgb) * (1.0 + tone + pores * 0.045);
+	if (shingles) {
+		vec2 grid = vec2(local.z / 0.36, local.x / 0.30);
+		grid.x += mod(floor(grid.y), 2.0) * 0.5;
+		vec2 cell = fract(grid);
+		float border = smoothstep(0.015, 0.08, min(cell.x, 1.0 - cell.x));
+		float lip = smoothstep(0.012, 0.15, cell.y);
+		color *= (0.72 + border * 0.14 + lip * 0.14) * (0.88 + hash(floor(grid)) * 0.23);
+	}
+	if (shingles || tiled_mesh) {
+		float cover = smoothstep(0.21, 0.67, sin(local.z * 1.8 + local.x * 2.4) * .19 + .51 + tone);
+		color = mix(color, vec3(.73,.82,.86) * (0.94 + tone), cover * snow_cover * top_side);
+	}
+	ALBEDO = color;
+	ROUGHNESS = 0.92;
+	SPECULAR = 0.21;
+}
diff --git a/shaders/a1_river.gdshader b/shaders/a1_river.gdshader
new file mode 100644
index 0000000..45ff0fc
--- /dev/null
+++ b/shaders/a1_river.gdshader
@@ -0,0 +1,19 @@
+shader_type spatial;
+render_mode cull_disabled, diffuse_burley;
+
+varying vec3 world_point;
+void vertex() {
+	world_point = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+}
+void fragment() {
+	float waves = sin(world_point.z * 3.2 + sin(world_point.x * 0.7 - TIME * 1.8) * 0.8);
+	float ripple = sin(world_point.x * 1.55 - TIME * 2.7 + world_point.z * 0.8);
+	float gleam = smoothstep(0.82, 1.0, waves * 0.65 + ripple * 0.35);
+	float center = 74.0 + 6.0 * sin(world_point.x * .057) * smoothstep(3.0, 16.0, abs(world_point.x));
+	float shoal = smoothstep(2.1, 5.7, abs(world_point.z - center) + waves * .20);
+	float foam = smoothstep(.85, .98, ripple) * smoothstep(.78, .98, shoal);
+	ALBEDO = mix(vec3(0.032, 0.26, 0.29), vec3(0.24, 0.56, 0.53), 0.12 + gleam * 0.26 + shoal * 0.48) + vec3(.19,.23,.17) * foam;
+	NORMAL = normalize(NORMAL + vec3(waves * 0.045, ripple * 0.038, 0.0));
+	ROUGHNESS = 0.32;
+	SPECULAR = 0.45;
+}
