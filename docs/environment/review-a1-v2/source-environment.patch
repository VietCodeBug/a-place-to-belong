+static func build(site: Node3D, at: Vector3, kind: int) -> void:
+	var house := Node3D.new()
+	house.name = ["CottagePorch","CottageDormer","CottageLong","CommunityPrototype"][kind]
+	site.add_child(house)
+	house.position = at
+	var facing := 1.0 if at.x < L.valley_path(at.z) else -1.0
+	house.rotation.y = facing * -1.10 if kind < 3 else 0.0
+	var span: Vector2 = [Vector2(4.9,4.2),Vector2(5.6,4.55),Vector2(7.4,4.3),Vector2(5.7,4.9)][kind]
+	var eave: float = [2.75,3.05,2.95,5.7][kind]
