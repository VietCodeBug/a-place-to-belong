+	finish(S.box(house, center, Vector3(width, height, depth), wall, true), wall)
+	for row in range(3):
+		for i in range(8):
+			var x := (i - 3.5) * width / 8.0
+			var stone := S.box(house, Vector3(x, 0.15 - row * 0.24, front - 0.045),
+				Vector3(width / 8.0 - 0.025, 0.22, 0.29), ["858275","8E887A","989081"][(i + row) % 3])
+			stone.rotation.y = sin(i * 3.4 + row) * 0.04
