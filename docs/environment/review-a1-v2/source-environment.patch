+			S.box(house,Vector3(x,3.53,front-0.16),Vector3(1.24,0.11,0.27),STONE)
+		S.beam(house,Vector3(-span.x*0.48,3.14,front-0.08),
+			Vector3(span.x*0.48,3.14,front-0.08),0.19,WOOD)
+		var lantern_tower := Node3D.new()
+		house.add_child(lantern_tower)
+		lantern_tower.position = Vector3(0,eave+rise-0.73,0.32)
+		envelope(site,lantern_tower,Vector2(1.89,1.83),2.16,0.94,0.0,plaster,false)
+		roof(site,lantern_tower,Vector2(1.89,1.83),2.16,0.94,0.0,tiles)
+		site.window(lantern_tower,Vector3(0,1.13,-0.95),0.58)
+	else:
+		A.place(house,"fantasy-town","chimney",Vector3(1.38,eave+rise*0.34,0.86),1.85)
+	var threshold := house.to_global(Vector3(door_x,0,front-1.65))
+	site.paving(Vector2(threshold.x,threshold.z),Vector2(L.valley_path(threshold.z),threshold.z-0.35),1.04)
+	for i in range(12):
+		var border := house.to_global(Vector3((i-5.5)*span.x/11.8,0,front-1.71-0.24*sin(i*4.7)))
+		if absf(border.x-L.valley_path(border.z))<2.26 or absf((i-5.5)*span.x/11.8-door_x)<1.04:
+			continue
+		border.y = L.height_at(border.x,border.z)
+		var bloom := "flower_yellowA" if kind == 2 else "flower_purpleB"
+		A.place(site,"nature",bloom if i%3==0 else "grass_leafs",border,0.28+0.19*absf(sin(i)),i)
+		if i in [1,10]:
