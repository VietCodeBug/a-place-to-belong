+		for v in ([0, 1, 2] if side < 0 else [2, 1, 0]):
+			gable.add_vertex(corners[v])
+	gable.generate_normals()
+	finish(S.mesh(house, gable.commit(), Vector3.ZERO, wall), wall)
+	for side in [-1, 1]:
+		var x := float(side) * (width * 0.5 + 0.32)
+		var panel := S.box(house, Vector3(x * 0.5, (height + peak) * 0.5, 0),
+			Vector3(tile_length, 0.21, depth + 0.86), roof)
+		panel.rotation.z = -side * pitch
+		finish(panel, roof, true)
+		for z in [front - 0.43, -front + 0.43]:
+			S.beam(house, Vector3(0,peak+0.10,z), Vector3(x,height+0.03,z), 0.18, beam)
+	for x in [-width * 0.5 + 0.10, width * 0.5 - 0.10]:
+		S.box(house, Vector3(x,height * 0.5,front-0.08), Vector3(0.21,height,0.23), beam)
+	for y in [0.39,height-0.14]:
+		S.box(house, Vector3(0,y,front-0.078), Vector3(width,0.20,0.20), beam)
+	var doorway := -0.68 if index % 2 == 0 else 0.61
+	S.box(house, Vector3(doorway,1.15,front-0.10), Vector3(1.24,2.16,0.24), beam)
+	for i in range(6):
+		S.box(house, Vector3(doorway+(i-2.5)*0.159,1.12,front-0.235),
+			Vector3(0.153,1.89,0.07), ["8E654A","79563F","9E7356"][i % 3])
+	for y in [0.54,1.75]:
+		S.box(house, Vector3(doorway,y,front-0.28), Vector3(1.02,0.09,0.06), beam)
+	facet(house, Vector3(doorway+0.35,1.02,front-0.32), Vector3.ONE*0.09, "CE9C54")
+	for i in range(3):
+		S.box(house, Vector3(doorway,0.04-i*0.075,front-0.39-i*0.28),
+			Vector3(1.57+i*0.13,0.22,0.53), "91867A")
+	for x in [-width*0.32, width*0.32]:
+		var y := 1.86 if absf(x-doorway)>1.18 else 2.56
+		window(house, Vector3(x,y,front-0.12), 0.77)
+		for side in [-1,1]:
+			S.box(house, Vector3(x+side*0.55,y,front-0.18),Vector3(0.24,0.97,0.09),"5F7367")
+		if y < 2.0:
+			S.box(house, Vector3(x,1.25,front-0.25),Vector3(1.09,0.20,0.35),"895C40")
+			for flower in range(3):
+				A.place(house,"nature","flower_redC" if index%2==0 else "flower_purpleB",
+					Vector3(x+(flower-1)*0.32,1.31,front-0.29),0.31,flower)
+	window(house, Vector3(0,height+0.55,front-0.07),0.58)
+	var chimney := A.place(house,"fantasy-town","chimney",Vector3(width*0.29,height+0.29,depth*0.18),1.8)
+	chimney.rotation.y = PI * 0.5
+	if index in [0, 2, 4]:
