+		dormer.position = Vector3(1.05,eave+0.48,-0.65)
+		var inset := Vector2(1.30,1.78)
+		envelope(site,dormer,inset,0.71,0.48,0.0,plaster,false)
+		roof(site,dormer,inset,0.71,0.48,0.0,tiles)
+		site.window(dormer,Vector3(0,0.43,-0.93),0.43)
+	elif kind == 2:
+		var annex := Node3D.new()
+		house.add_child(annex)
+		annex.position = Vector3(span.x*0.5+0.96,0,0.66)
+		envelope(site,annex,Vector2(2.25,2.8),2.28,0.63,-0.62,plaster)
+		roof(site,annex,Vector2(2.25,2.8),2.28,0.63,-0.62,tiles)
+		base(annex,Vector2(2.25,2.8))
+		site.window(annex,Vector3(0.13,1.29,-1.46),0.57)
+	elif kind == 3:
